# Frontend environment variables (Vite reads only names starting with VITE_)
# Local development: leave both empty. /api is proxied to http://localhost:5000 by vite.config.js.

# Hosted: full backend API URL, including /api
VITE_API_URL=
# Hosted: backend origin for Socket.IO (no /api), e.g. https://ridewave-api.onrender.com
VITE_SOCKET_URL=

# Maps use OpenStreetMap (Leaflet), no API key needed.
