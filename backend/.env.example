# Backend environment variables
# Database:
#   local                     = built-in database, nothing to install (first run downloads MongoDB once, ~70 MB)
#   mongodb+srv://...         = MongoDB Atlas (needed for the hosted / phone demo)
MONGO_URI=local
# Change this for hosting. Any long random text works.
JWT_SECRET=ridewave_local_dev_secret_change_me
PORT=5000

# Demo accounts are created automatically in an empty database (SEED_DEMO=off to disable)
ADMIN_NAME=RideWave Admin
ADMIN_EMAIL=admin@ridewave.app
ADMIN_PASSWORD=Admin@123

# Allowed frontend origins for CORS and Socket.IO (comma separated).
# In production set your hosted frontend URL.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Razorpay test-mode keys (https://dashboard.razorpay.com > Settings > API Keys, Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Pool matching for instant pools:
#   proximity = Sem 7 rule (default, safest)
#   corridor  = Sem 8 route-corridor matching
#   smart     = corridor + AI ranking (needs backend/ml/pairing-model.json, created by npm run train)
POOL_MATCHER=proximity
# Road routes for corridor matching: osrm (default, falls back to straight lines) or off
ROUTING=osrm
OSRM_URL=https://router.project-osrm.org

# SMTP for sending OTP emails (free with any Gmail account).
# 1. Enable 2FA on your Google account
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Fill in SMTP_USER (your Gmail) and SMTP_PASS (the 16-character app password)
# Leave empty to print OTP to the console instead (demo mode, auto-filled on the register page).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
